generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  user_id        Int            @id @default(autoincrement())
  username       String?        @unique
  password       String?
  fullname       String
  nickname       String?
  phone_number   String?
  age            Int?
  global_role    Role           @default(GOLFER)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt
  profile_icon   String?        @default("https://api.dicebear.com/7.x/adventurer/svg?seed=porn")
  flights_joined FlightMember[]
  scores         Score[]

  @@map("users")
}

model Course {
  course_id   Int          @id @default(autoincrement())
  course_name String
  location    String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt
  sections    Section[]
  tournaments Tournament[]

  @@map("courses")
}

model Section {
  section_id   Int      @id @default(autoincrement())
  course_id    Int
  section_name String
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  holes        Hole[]
  course       Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@index([course_id], map: "sections_course_id_fkey")
  @@map("sections")
}

model Hole {
  hole_id    Int      @id @default(autoincrement())
  section_id Int
  hole_no    Int
  par        Int
  index      Int?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  section    Section  @relation(fields: [section_id], references: [section_id], onDelete: Cascade)
  scores     Score[]

  @@index([section_id], map: "holes_section_id_fkey")
  @@map("holes")
}

model Tournament {
  tournament_id   Int      @id @default(autoincrement())
  tournament_name String
  tournament_mode String   @default("Stroke Play")
  use_age_option  Boolean  @default(false)
  course_id       Int
  event_date      DateTime @db.Date
  status          String   @default("setup")
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
  peoria_holes    String?
  flights         Flight[]
  course          Course   @relation(fields: [course_id], references: [course_id])

  @@index([course_id], map: "tournaments_course_id_fkey")
  @@map("tournaments")
}

model Flight {
  flight_id     Int            @id @default(autoincrement())
  tournament_id Int
  flight_name   String
  t_off_time    String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  members       FlightMember[]
  tournament    Tournament     @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)
  scores        Score[]

  @@index([tournament_id], map: "flights_tournament_id_fkey")
  @@map("flights")
}

model FlightMember {
  flight_member_id Int      @id @default(autoincrement())
  flight_id        Int
  user_id          Int
  handicap_claim   Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  calculated_hd    Float?   @default(0)
  calculated_net   Float?   @default(0)
  flight           Flight   @relation(fields: [flight_id], references: [flight_id], onDelete: Cascade)
  user             User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([flight_id, user_id])
  @@index([user_id], map: "flight_members_user_id_fkey")
  @@map("flight_members")
}

model Score {
  score_id    Int      @id @default(autoincrement())
  flight_id   Int
  user_id     Int
  hole_id     Int
  strokes     Int
  recorded_at DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  flight      Flight   @relation(fields: [flight_id], references: [flight_id], onDelete: Cascade)
  hole        Hole     @relation(fields: [hole_id], references: [hole_id])
  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([flight_id], map: "scores_flight_id_fkey")
  @@index([hole_id], map: "scores_hole_id_fkey")
  @@index([user_id], map: "scores_user_id_fkey")
  @@map("scores")
}

enum Role {
  ADMIN
  TD
  SCORER
  GOLFER
}
